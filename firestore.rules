rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the single owning account (matched by uid AND email) may read or
    // write its own data tree. Nobody else - including other authenticated
    // Google accounts - can access anything.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email == "ashmitamalik82@gmail.com";
    }
  }
}
