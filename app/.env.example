# Copy this file to .env.local for local dev, and set the same keys as
# GitHub Actions repo secrets (see README) for the deployed build.

# Firebase web app config (Firebase Console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Cloud OAuth 2.0 Client ID (Web application) with Calendar API scope
VITE_GOOGLE_CLIENT_ID=

# The only Google account allowed to use this app
VITE_ALLOWED_EMAIL=a999malik@gmail.com

# URL of the deployed Cloudflare Worker backend (or http://localhost:8787 for local dev)
VITE_WORKER_URL=http://localhost:8787

# Personal Apple Shortcuts trigger link ("Edith, play Mulemantra"). Not
# secret exactly, but kept out of the public repo since it's your own
# automation - anyone with it could trigger your Alexa.
VITE_ALEXA_SHORTCUT_URL=
